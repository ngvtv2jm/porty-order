# Public frontend settings, use your project's publishable/anon key, never a service-role key.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Server-only Supabase Edge Function secrets, set with the Supabase dashboard or CLI:
# DATABASE_URL = Supabase transaction pooler PostgreSQL URL (private)
# ALLOWED_ORIGINS = https://your-bolt-site.example,http://localhost:5173 (exact origins, comma separated)
# ADMIN_SETUP_HASH = SHA256 of a new random one-time activation code (private)
# SUPABASE_URL and SUPABASE_ANON_KEY are supplied to the function by Supabase.
